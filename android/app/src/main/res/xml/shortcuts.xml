<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon to reach Settings. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.sorrypoundsand.fppwledremote.SetupActivity"
            android:targetPackage="com.sorrypoundsand.fppwledremote" />
    </shortcut>
</shortcuts>
